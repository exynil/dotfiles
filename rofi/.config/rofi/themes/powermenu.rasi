@import "colors.rasi"

* {
    font:                   "JetBrainsMono NFP 16";
    background-color:       transparent;
    text-color:             @fg;
}
window {
    transparency:           "real";
    width:                  1140px;
    background-color:       @glass;
    border:                 1px;
    border-color:           @accent-line;
    border-radius:          24px;
}
mainbox {
    padding:                32px;
    spacing:                18px;
}
inputbar {
    padding:                0 6px;
    spacing:                12px;
    children:               [ textbox-prompt-colon, prompt ];
}
textbox-prompt-colon {
    expand:                 false;
    str:                    "󰅐";
    text-color:             @accent;
}
prompt {
    text-color:             @fg-dim;
}
listview {
    layout:                 horizontal;
    spacing:                14px;
}
element {
    background-color:       @tile;
    border:                 1px;
    border-color:           @stroke;
    border-radius:          18px;
    padding:                40px 70px;
}
element selected {
    background-color:       @accent;
    border-color:           @accent;
    text-color:             @on-accent;
}
element-text {
    font:                   "JetBrainsMono NFP 64";
    background-color:       transparent;
    text-color:             inherit;
    horizontal-align:       0.5;
    vertical-align:         0.5;
}
