@import "colors.rasi"

* {
    font:                   "JetBrainsMono NFP 12";
    background-color:       transparent;
    text-color:             @fg;
    highlight:              bold #7dcfff;
}
window {
    transparency:           "real";
    width:                  850px;
    background-color:       @glass;
    border:                 1px;
    border-color:           @accent-line;
    border-radius:          16px;
}
mainbox {
    padding:                20px;
    spacing:                12px;
}
inputbar {
    padding:                10px 14px;
    spacing:                10px;
    background-color:       @field;
    border:                 1px;
    border-color:           @stroke;
    border-radius:          10px;
    children:               [ prompt, entry ];
}
prompt {
    text-color:             @accent;
}
entry {
    placeholder:            "поиск…";
    placeholder-color:      @fg-dim;
    cursor-color:           @accent;
}
textbox {
    padding:                8px 12px;
    background-color:       @field;
    border-radius:          10px;
    text-color:             @fg-dim;
}
listview {
    lines:                  15;
    spacing:                3px;
    scrollbar:              false;
    fixed-height:           true;
}
element {
    padding:                8px 12px;
    border:                 0 0 0 3px;
    border-color:           transparent;
    border-radius:          8px;
    children:               [ element-text ];
}
element selected {
    background-color:       @accent-glow;
    border-color:           @accent;
}
element-text {
    background-color:       transparent;
    text-color:             inherit;
}
