@import "colors.rasi"

* {
    font:                   "JetBrainsMono NFP 64";
    background-color:       transparent;
    text-color:             @fg;
}
window {
    transparency:           "real";
    width:                  700px;
    location:               east;
    x-offset:               -20px;
    y-offset:               0;
    background-color:       @glass;
    border:                 1px;
    border-color:           @accent-line;
    border-radius:          20px;
}
mainbox {
    padding:                24px;
    children:               [ listview ];
}
listview {
    layout:                 vertical;
    columns:                3;
    lines:                  4;
    spacing:                14px;
}
element {
    background-color:       @tile;
    border:                 1px;
    border-color:           @stroke;
    border-radius:          16px;
    padding:                20px;
}
element selected {
    background-color:       @accent-glow;
    border-color:           @accent;
}
element-text {
    background-color:       transparent;
    text-color:             inherit;
    horizontal-align:       0.5;
    vertical-align:         0.5;
}
